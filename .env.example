# Copy this file to .env and fill in the values. NEVER put real keys in this example file.

# Telegram: create a bot with @BotFather and add it as an administrator of the group
TELEGRAM_BOT_TOKEN=
# The group (supergroup with Topics) and the ids of its two event topics (find them with tools/find_chats.py)
TELEGRAM_GROUP_ID=
TELEGRAM_THREAD_FUN=
TELEGRAM_THREAD_PROFESSIONAL=
# Optional: a private channel used by `post --test`, and your own chat id for health reports
TELEGRAM_TEST_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Only used if you post to a plain channel instead of the group
TELEGRAM_CHANNEL_ID=
# Anthropic API key for translation / summaries / classification
ANTHROPIC_API_KEY=
# Free key from https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
